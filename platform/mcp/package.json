{
  "name": "@studio/platform-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node dist/migrate.js",
    "smoke": "node --env-file=.env --import tsx src/smoke.ts",
    "migrate:dev": "node --env-file=.env --import tsx src/migrate.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0",
    "@neon/functions": "^0.11.0",
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
