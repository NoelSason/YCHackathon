# Business ops (Noel). Copy to the repo-root .env or the host's settings. Never commit real values.

# Data (the team's Neon database). Unset = in-memory store, fine for local runs.
DATABASE_URL=

# Naïve: agents:read, agents:write, sessions:write. Also used for the CRM.
NAIVE_API_KEY=
NAIVE_BASE_URL=https://api.vetta.sh
SALES_READER_AGENT_ID=
AGENT_MODEL=

# Monid: the CLI holds the key (`monid keys add`). This only marks it as configured.
MONID_API_KEY=
# Outreach loop stops reading stores for the day at this much Monid spend, USD (default 5)
MONID_DAILY_USD=5

# Mobilerun Cloud (dr_sk_...). Claiming the hackathon credits starts a 72-hour clock.
MOBILERUN_API_KEY=
MOBILERUN_DEVICE_ID=
# Second iPhone, signed in to the App Store by a person. Used when an App Store app can't be installed by the API.
MOBILERUN_APPSTORE_DEVICE_ID=
MOBILERUN_MODEL=mobilerun/mobile-agent-fast
# 1 = the phone playtests our levels (or studies free web puzzle games) between paid orders
PLAYTEST_LOOP=0
PLAYTEST_LOOP_MINUTES=30

# AgentMail: the sales inbox
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=levelai@agentmail.to
AGENTMAIL_WEBHOOK_SECRET=

# Stripe (test mode). Live keys are refused unless BILLING_ALLOW_LIVE=1.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_ALLOW_LIVE=0

# Prices (USD). Blank uses the approved default: level pack 49 (one-time), subscription 199 a month.
# The playtest is priced by PLAYTEST_PRICE_USD (5); unset makes playtests free. The developer API key is free.
PILOT_PRICE_USD=
PILOT_LEVELS=20
SUBSCRIPTION_PRICE_USD=
SUBSCRIPTION_LEVELS=40
SUBSCRIPTION_PLAYTESTS=4
PLAYTEST_PRICE_USD=
HINT_PACK_PRICE_USD=

# Outreach. Sending stays off (drafts only) until OUTREACH_SEND=1.
OUTREACH_SEND=0
OUTREACH_DAILY_CAP=20
COMPANY_NAME=Level AI
# Required by US email law (CAN-SPAM) before any email is sent.
COMPANY_POSTAL_ADDRESS=
PUBLIC_BASE_URL=http://localhost:8787

# OpenAI: double-checks review quotes before a cold email. Unset key = keyword match only.
OPENAI_API_KEY=
# Defaults to gpt-5.4-mini.
OPENAI_MODEL=
# Defaults to 300 calls a day.
OPENAI_DAILY_CALLS=

# Server
PORT=8787
BUSINESS_MCP_TOKEN=
BUSINESS_MCP_URL=
BUSINESS_BASE_URL=
NAIVE_API_KEY_SOCIAL=
NAIVE_SOCIAL_IDENTITY_ID=
SOCIAL_LOOP=1
SOCIAL_LOOP_MINUTES=120

# Encrypts studios' generator signing secrets (src/generators/): 64 hex chars, e.g. openssl rand -hex 32
GENERATOR_SECRET_KEY=

# Agency outreach and the sales agent (business/src/agency). Outreach is off unless AGENCY_OUTREACH=1.
AGENCY_OUTREACH=
AGENCY_OUTREACH_MINUTES=
AGENCY_DAILY_CAP=
CONVERSE=
CONVERSE_DAILY_CAP=
SOCIAL_QUIET_HOURS=
SOCIAL_DEMO_RESERVE=
