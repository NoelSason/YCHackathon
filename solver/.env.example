# Solver harness settings. Copy to .env and fill in. Never commit .env.

# Postgres the platform uses (Neon). Ask Abhinav.
DATABASE_URL=

# Set to 0 only for a local Postgres without TLS. Leave unset for Neon.
PGSSL=

# Optional. Defaults: <hostname>:<pid>, 1000 ms between polls when idle, 15 minutes before a
# 'running' run is treated as stuck.
WORKER_ID=
POLL_MS=
STALE_MINUTES=
